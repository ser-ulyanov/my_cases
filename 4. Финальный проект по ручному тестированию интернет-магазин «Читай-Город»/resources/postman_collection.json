      "item": [
        {
          "name": "Успешное обновление токена (валидный refresh token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Берём ответ сервера\r",
                  "let json = pm.response.json();\r",
                  "\r",
                  "// Достаём токены из структуры ответа\r",
                  "let access = json.data?.attributes?.token?.accessToken;\r",
                  "let refresh = json.data?.attributes?.token?.refreshToken;\r",
                  "\r",
                  "// Сохраняем в переменные КОЛЛЕКЦИИ (collection variables)\r",
                  "if (access) pm.collectionVariables.set('access_token', access);\r",
                  "if (refresh) pm.collectionVariables.set('refresh_token', refresh);\r",
                  "\r",
                  "// Тест на статус 200\r",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "// Тест на наличие токенов\r",
                  "pm.test(\"Tokens exist\", () => {\r",
                  "    pm.expect(access).to.not.be.undefined;\r",
                  "    pm.expect(refresh).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "// Лог для наглядности\r",
                  "console.log(\"Updated tokens:\", { access_token: access, refresh_token: refresh });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
